# ==============================================================================
# Smart Payment Retry Engine - Environment Variables Configuration Template
# NOTE: DO NOT PUT REAL SECRETS IN THIS FILE. Copy to .env and configure.
# ==============================================================================

# Server Environment
FLASK_ENV=development
PORT=5005

# Cryptographic Keys (Required in production)
SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars
JWT_SECRET_KEY=change-me-to-a-secure-random-jwt-secret-key-32-chars

# Database Connection (SQLite default)
DATABASE_URL=sqlite:///backend/instance/payments.db

# CORS Allowed Origins (Comma-separated list of trusted domains)
FRONTEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000

# Security Policies
ENABLE_SEED_ENDPOINT=false
RATELIMIT_DEFAULT=120 per minute

# Initial Default Accounts (Optional override)
DEFAULT_USER_PASS=User@12345
DEFAULT_ADMIN_PASS=Admin@12345
